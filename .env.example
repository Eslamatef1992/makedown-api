# Server
NODE_ENV=development
PORT=4000
API_BASE_URL=https://back.makedown.online
CORS_ORIGINS=https://www.makedown.online,https://admin.makedown.online,http://localhost:5173,http://localhost:5174

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=makedown
DB_USER=makedown_user
DB_PASSWORD=changeme

# JWT
JWT_ACCESS_SECRET=changeme_access_secret
JWT_ADMIN_SECRET=changeme_admin_secret
JWT_ADMIN_EXPIRES_IN=12h
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN_REMEMBER=90d

# OTP
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10

# Mail (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=no-reply@makedown.online
MAIL_PASSWORD=changeme
MAIL_FROM="Make Down <no-reply@makedown.online>"

# MyFatoorah (payments) — filled in when e-commerce module is built
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://api.myfatoorah.com
MYFATOORAH_COUNTRY=KWT
